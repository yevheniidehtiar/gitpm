{
  "name": "gitpm-monorepo",
  "private": true,
  "license": "MIT",
  "description": "Git-native project management — monorepo root for gitpm",
  "homepage": "https://github.com/yevheniidehtiar/gitpm#readme",
  "bugs": {
    "url": "https://github.com/yevheniidehtiar/gitpm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yevheniidehtiar/gitpm.git"
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "dev:ui": "bun run --filter @gitpm/ui dev",
    "docs": "uvx zensical serve",
    "docs:build": "uvx zensical build --clean --strict",
    "gitpm": "node packages/cli/dist/index.js",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "tsup": "^8.3.0",
    "typescript": "^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "vitest": "^5.0.5"
  }
}
